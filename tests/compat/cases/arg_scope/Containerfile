ARG GLOBAL=g
ARG SHADOW=outer
ARG G2=g2
FROM scratch AS first
ENV SEEN=${GLOBAL:-unset}
ARG GLOBAL
ENV REDECLARED=$GLOBAL
ARG SHADOW=inner
ENV SHADOWED=$SHADOW
ARG FROM_ENV=$REDECLARED
ENV CHAIN=$FROM_ENV
ENV SHADOW=env
ARG SHADOW=arg
ENV WINS=$SHADOW
ENV G2=env
ARG G2
ENV G2OUT=$G2
ENV BARE=env
ARG BARE
ENV BAREOUT=$BARE
COPY a.txt /a
FROM first
ENV NEXT=${GLOBAL:-unset}/${REDECLARED:-unset}
